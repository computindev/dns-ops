{
  "name": "@dns-ops/db",
  "version": "0.1.0",
  "description": "Shared database client and schema for DNS Ops Workbench",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "types": "./dist/schema/index.d.ts"
    }
  },
  "scripts": {
    "build": "bun run --filter @dns-ops/contracts build && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "test": "echo 'No unit tests - schema only'",
    "migrate": "drizzle-kit migrate:pg",
    "generate": "drizzle-kit generate:pg",
    "studio": "drizzle-kit studio",
    "verify-migrations": "npx tsx scripts/verify-migrations.ts",
    "verify-operations-concurrency": "npx tsx scripts/verify-operations-concurrency.ts",
    "check-drift": "npx tsx scripts/check-drift.ts"
  },
  "dependencies": {
    "@dns-ops/contracts": "workspace:*",
    "better-result": "^2.7.0",
    "drizzle-orm": "^0.29.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@types/pg": "^8.10.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
